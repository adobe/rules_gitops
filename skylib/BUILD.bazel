load(":stamp.bzl", "more_stable_status", "stamp_value")

licenses(["notice"])  # Apache 2.0

exports_files([
    "k8s_gitops.sh.tpl",
    "k8s_cmd.sh.tpl",
    "k8s_test_namespace.sh.tpl",
    "push-tag.sh.tpl",
])

stamp_value(
    name = "build_user_value",
    str = "{BUILD_USER}",
    visibility = ["//visibility:public"],
)

more_stable_status(
    name = "more_stable_status",
    vars = [
        "BUILD_USER",
    ],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "external_image",
    srcs = ["external_image.bzl"],
    visibility = ["//visibility:public"],
    deps = [":push"],
)

bzl_library(
    name = "k8s",
    srcs = ["k8s.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":push",
        "//skylib/kustomize",
    ],
)

bzl_library(
    name = "push",
    srcs = ["push.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "@bazel_skylib//lib:dicts",
        "@io_bazel_rules_docker//container:layer_tools",
        "@io_bazel_rules_docker//container:providers",
        "@io_bazel_rules_docker//skylib:path",
    ],
)

bzl_library(
    name = "run_in_workspace",
    srcs = ["run_in_workspace.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "stamp",
    srcs = ["stamp.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "templates",
    srcs = ["templates.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "test_rules",
    srcs = ["test_rules.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    visibility = ["//visibility:public"],
)
