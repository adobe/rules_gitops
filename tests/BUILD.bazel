load("@bazel_tools//tools/build_rules:test_rules.bzl", "rule_test")
load("//kustomize:defs.bzl", "kustomization")
load("//kubectl:defs.bzl", "kubectl_binary")
load("//gitops:defs.bzl", "gitops")
load("@rules_gitops//adapters:rules_img.bzl", "image_descriptor")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "image_layer")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:push.bzl", "image_push")
load(":util.bzl", "file_compare_test")



REGISTRY = "localhost:15000"

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# to generate new test data if needed:
# bazel run //skylib/kustomize:set_namespace newnamespace-1 <test.yaml >test_expected.yaml
sh_test(
    name = "set_namespace_test",
    size = "small",
    srcs = ["set_namespace_test.sh"],
    data = [
        "test.yaml",
        "test_expected.yaml",
        "//testing/private:set_namespace",
    ],
)

# Verify that rule is combining files without processing
kustomization(
    name = "raw_test",
    testonly = True,
    manifests = [
        "deployment.yaml",
        "service.yaml",
        "crb.yaml",
    ],
    namespace = "",
)

rule_test(
    name = "raw_generates_yaml",
    generates = ["raw_test.yaml"],
    rule = "raw_test",
)

file_compare_test(
    name = "raw_file",
    expected = "goldens/expected_raw_test.yaml",
    file = ":raw_test",
)

kustomization(
    name = "namespace_test",
    testonly = True,
    manifests = [
        "deployment.yaml",
        "service.yaml",
        "crb.yaml",
    ],
    namespace = "bs-dev",
)

file_compare_test(
    name = "has_namespace",
    file = ":namespace_test",
    expected = "goldens/expected_namespace_test"
)

filegroup(
    name = "alltestfiles",
    testonly = True,
    srcs = [
        "crb.yaml",
        "deployment.yaml",
        "service.yaml",
    ],
)

kustomization(
    name = "raw2_test",
    testonly = True,
    manifests = [
        ":alltestfiles",
    ],
    namespace = "",
)

file_compare_test(
    name = "raw2_file",
    expected = "goldens/expected_raw_test.yaml",
    file = ":raw2_test",
    
)

image_layer(
    name = "base",
    srcs = {
        "/bin/app": "container_content.txt",
    },
)

image_manifest(
    name = "image",
    entrypoint = ["/bin/sh"],
    base = "@alpine",
    platform = ":linux_amd64",
    layers = [
        ":base",
    ],
)

image_push(
    name = "push",
    image = ":image",
    registry = REGISTRY,
    repository = "rules_gitops/tests/image",
    visibility = ["//:__pkg__"],
)

image_descriptor(
    name = "k8s_image",
    image = ":image",
    push = ":push",
    registry = REGISTRY,
    repository = "rules_gitops/tests/image"
)

kustomization(
    name = "image_test",
    testonly = True,
    images = [
        ":k8s_image",
    ],
    manifests = [
        "deployment.yaml",
        "service.yaml",
        "crb.yaml",
    ],
    namespace = "",
)

genrule(
    name = "goldens/expected_image_resolved_test_yaml",
    srcs = [
        ":goldens/expected_image_resolved_test.tpl.yaml",
        ":image.digest",
    ],
    outs = ["goldens/expected_image_resolved_test.yaml"],
    cmd = " ".join([
        "./$(location //templating:fast_template_engine)",
        "--template=$(location goldens/expected_image_resolved_test.tpl.yaml)",
        "--variable=IMAGE_DIGEST=$$(cat $(location :image.digest))",
        "--output=$@",
    ]),
    tools = [
        "//templating:fast_template_engine",
    ],
)

file_compare_test(
    name = "image_resolved_file",
    expected = ":goldens/expected_image_resolved_test_yaml",
    file = ":image_test",
    
)

kustomization(
    name = "image_digest_test",
    testonly = True,
    images = [
        ":k8s_image",
    ],
    manifests = [
        "deployment.yaml",
        "service.yaml",
        "crb.yaml",
    ],
    namespace = "",
)

file_compare_test(
    name = "image_digest_resolved_file",
    expected = "goldens/expected_image_resolved_test.yaml",
    file = ":image_test",
)

kustomization(
    name = "configmap_test",
    testonly = True,
    configmaps_srcs = glob(["configmaps/**/*"]),
    namespace = "",
)

file_compare_test(
    name = "configmap_test_file",
    expected = "goldens/expected_configmap_test.yaml",
    file = ":configmap_test",
)

kustomization(
    name = "secret_test",
    testonly = True,
    namespace = "",
    secrets_srcs = glob(["secrets/**/*"]),
)

file_compare_test(
    name = "secret_test_file",
    expected = "goldens/expected_secret_test.yaml",
    file = ":secret_test",
)

kustomization(
    name = "integration_test",
    testonly = True,
    images = [
        ":k8s_image",
    ],
    manifests = [
        "deployment.yaml",
        "service.yaml",
        ":configmap_test",
    ],
    namespace = "{BUILD_USER}",
)

kubectl_binary(
    name = "mynamespace.apply",
    testonly = True,
    srcs = [":integration_test"],
    cluster = "dev3",
    namespace = "test",
)

gitops(
    name = "dev-something.gitops",
    testonly = True,
    srcs = [":namespace_test"],
    cluster = "dev",
    namespace = "test",
)

