kustomization(
    name = "image_test",
    testonly = True,
    images = [
        ":k8s_image",
    ],
    manifests = [
        "deployment.yaml",
        "service.yaml",
        "crb.yaml",
    ],
    namespace = "",
)

genrule(
    name = "goldens/expected_image_resolved_test_yaml",
    srcs = [
        ":goldens/expected_image_resolved_test.tpl.yaml",
        ":image.digest",
    ],
    outs = ["goldens/expected_image_resolved_test.yaml"],
    cmd = " ".join([
        "./$(location //templating:fast_template_engine)",
        "--template=$(location goldens/expected_image_resolved_test.tpl.yaml)",
        "--variable=IMAGE_DIGEST=$$(cat $(location :image.digest))",
        "--output=$@",
    ]),
    tools = [
        "//templating:fast_template_engine",
    ],
)

