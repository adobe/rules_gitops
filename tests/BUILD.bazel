)

# Verify that rule is combining files without processing
kustomization(
    name = "raw_test",
    testonly = True,
    manifests = [
        "deployment.yaml",
        "service.yaml",
        "crb.yaml",
    ],
    namespace = "",
)

rule_test(
    name = "raw_generates_yaml",
    generates = ["raw_test.yaml"],
    rule = "raw_test",
)

