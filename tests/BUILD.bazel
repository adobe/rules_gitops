#-------------------
# patch plus image
kustomization(
    name = "patch",
    images = [
        ":k8s_image",
    ],
    manifests = ["deployment.yaml"],
    namespace = "",
    patches = ["overlay/deployment.yaml"],
)

genrule(
    name = "goldens/expected_patch_yaml",
    srcs = [
        ":goldens/expected_patch.tpl.yaml",
        ":image.digest",
    ],
    outs = ["goldens/expected_patch.yaml"],
    cmd = " ".join([
        "./$(location //templating:fast_template_engine)",
        "--template=$(location goldens/expected_patch.tpl.yaml)",
        "--variable=IMAGE_DIGEST=$$(cat $(location :image.digest))",
        "--output=$@",
    ]),
    tools = [
        "//templating:fast_template_engine",
    ],
)

file_compare_test(
    name = "patch_test",
    expected = ":goldens/expected_patch_yaml",
    file = ":patch",
    
)

