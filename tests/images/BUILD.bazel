load("@rules_gitops//adapters:rules_img.bzl", "image_descriptor")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "image_layer")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:push.bzl", "image_push")

package(
    default_visibility = ["//tests:__subpackages__"]
)

REGISTRY = "localhost:15000"

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

image_layer(
    name = "base",
    srcs = {
        "/bin/app": "container_content.txt",
    },
)

image_manifest(
    name = "image",
    base = "@alpine",
    entrypoint = ["/bin/sh"],
    layers = [
        ":base",
    ],
    platform = ":linux_amd64",
)

image_push(
    name = "push",
    image = ":image",
    registry = REGISTRY,
    repository = "rules_gitops/tests/images/image",
    visibility = ["//:__pkg__"],
)

image_descriptor(
    name = "k8s_image",
    image = ":image",
    push = ":push",
    registry = REGISTRY,
    repository = "rules_gitops/tests/images/image",
)