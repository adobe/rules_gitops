load("@bazel_lib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "rules_img",
    srcs = ["rules_img.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":providers",
        "@rules_img//img:providers",
    ],
)

bzl_library(
    name = "external_image",
    srcs = ["external_image.bzl"],
    visibility = ["//visibility:public"],
    deps = [":providers"],
)
